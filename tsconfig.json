{
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/models",
    "src/database/seed.ts",
    "src/routes/dashboard.route.ts",
    "src/routes/medico.routes.ts",
    "src/routes/utente.routes.ts",
    "src/controller/auth.controller.ts",
    "src/controller/medico.controller.ts",
    "src/services/auditoria.services.ts",
    "src/services/medico.services.ts",
    "src/dtos/auditoria/create-auditoria.dto.ts",
    "src/ux/carat.component.ts"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
